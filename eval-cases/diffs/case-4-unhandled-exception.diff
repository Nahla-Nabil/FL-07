+def handle_webhook_event(payload: dict) -> str:
+    """Entry point for inbound payment-provider webhook events."""
+    account_id = payload["data"]["account_id"]
+    amount_cents = payload["data"]["amount_cents"]
+    fee_cents = payload["data"]["fee_cents"]
+    net_cents = amount_cents - fee_cents
+    split_count = payload["data"]["split_count"]
+    per_split_cents = net_cents // split_count
+    return charge_card(account_id, per_split_cents)
